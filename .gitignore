*.pt
*.pth
*.safetensors

# Ship calibrated production checkpoints with the repository.
!checkpoints/ink_beaker/
!checkpoints/pastry/
!checkpoints/production/*.pt
!checkpoints/production/*.json
!checkpoints/ink_beaker/*
!checkpoints/pastry/*
