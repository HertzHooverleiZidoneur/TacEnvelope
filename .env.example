# Python environment containing torch and the local LeRobot installation.
PYTHON_BIN=/absolute/path/to/lerobot/.venv/bin/python

# Combined collection root and its two asynchronously recorded sources.
DATASET_ROOT=/absolute/path/to/franka_usb_tactile_310_20260716
ROBOT_DATASET=/absolute/path/to/franka_usb_tactile_310_20260716/source_frames/franka_lerobot_20260715_170207_tactile
TACTILE_ROOT=/absolute/path/to/franka_usb_tactile_310_20260716/tactile_raw/franka_lerobot_20260715_170207_tactile

# Frozen SmolVLA checkpoint used for condition-token extraction.
SMOLVLA_CHECKPOINT=/absolute/path/to/smolvla/checkpoints/last/pretrained_model

# Generated workspace. This may become several GB because condition_tokens.pt is cached here.
OUTPUT_DIR=/absolute/path/to/tactile_force_envelope/outputs/training/my_experiment

# Needed only by recalibration, stable-contact evaluation, and report commands.
ENVELOPE_SOURCE_CHECKPOINT=/absolute/path/to/transformer_force_envelope_model.pt
ENVELOPE_ANALYSIS_CHECKPOINT=/absolute/path/to/transformer_force_envelope_contact_calibrated.pt
ENVELOPE_INFERENCE_CHECKPOINT=/absolute/path/to/tactile_force_envelope/checkpoints/production/current_stable_contact.pt
